#pragma once

namespace hm {

// Single source of truth for the version string reported by the CLI
// (--version) and written into every table's stats sidecar
// (generator_version). Generated by CMake from the repo-root VERSION file --
// do not edit the generated copy under build/generated/. Carries the fork
// suffix (HELPMATE_VERSION_SUFFIX in src/core/CMakeLists.txt).
inline constexpr const char* HELPMATE_VERSION = "@PROJECT_VERSION@@HELPMATE_VERSION_SUFFIX@";
// The bare X.Y.Z from VERSION, for consumers that must match the Python
// package metadata (PEP 440 has no "-suffix" form).
inline constexpr const char* HELPMATE_RELEASE_VERSION = "@PROJECT_VERSION@";

}  // namespace hm
