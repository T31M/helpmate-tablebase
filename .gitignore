# static showcase: the board component is copied in by `make site`
site/vendor/

# The showcase keeps its ES modules under site/js/lib; the Python build-artifact
# rule above (lib/) would hide them, and did once -- the first Pages deploy failed
# on a missing module.
!site/js/lib/

# published-problem databases used by tools/published_problems.py; not ours to redistribute
sampledata/

# Generated by tools/render_site.py on every `make site` from the committed
# JSON in site/data. Derived, deterministic and cheap to rebuild, so it is not
# committed -- 302 files of generated markup would swamp every diff.
site/material/
site/themes.html

# Superpowers SDD scratch: ledgers, briefs, review diffs. Working notes for
# an in-flight plan, not project history -- git log is the record.
.superpowers/

# Built at deploy by the Pages workflow, never committed.
site/data/status.json
